{
  "x-regex": "^(?:(?:<think>\\n?)?(?:(?P<reasoning_content>.*?\\S.*?)\\n?|[\\s]*)</think>\\s*)?(?P<content>(?:(?!<tool_call>)[\\s\\S])*?)(?:\\n+(?=<tool_call>))?(?=(?:<tool_call>|<\\|im_end\\|>|$))(?P<tool_calls>(?:<tool_call>(?:(?!</tool_call>)[\\s\\S])+</tool_call>\\s*)+)?\\s*(?:<\\|im_end\\|>|$)",
  "type": "object",
  "properties": {
    "role": {
      "const": "assistant"
    },
    "content": {
      "type": "string"
    },
    "reasoning_content": {
      "type": "string"
    },
    "tool_calls": {
      "type": "array",
      "x-regex-iterator": "<tool_call>\\s*(.+?)\\s*</tool_call>",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "function"
          },
          "function": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "x-regex": "<function=([^\\n>]+)>"
              },
              "arguments": {
                "type": "object",
                "x-regex-key-value": "<parameter=(?P<key>[^>\\n]+)>\\n(?P<value>.*?)\\n</parameter>",
                "default": {},
                "additionalProperties": {
                  "x-parser": "json",
                  "x-parser-args": {
                    "allow_non_json": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
