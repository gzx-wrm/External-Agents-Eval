{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SpecOutput",
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1
    },
    "TaskSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field",
        "quote"
      ],
      "properties": {
        "kind": {
          "const": "task"
        },
        "field": {
          "enum": [
            "title",
            "description"
          ]
        },
        "quote": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "RepositorySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "line_start",
        "line_end"
      ],
      "properties": {
        "kind": {
          "const": "repository"
        },
        "path": {
          "$ref": "#/$defs/Text"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Source": {
      "oneOf": [
        {
          "$ref": "#/$defs/TaskSource"
        },
        {
          "$ref": "#/$defs/RepositorySource"
        }
      ]
    },
    "Sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "TargetDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "importance",
        "sources"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/Text"
        },
        "importance": {
          "enum": [
            "required",
            "advisory"
          ]
        },
        "sources": {
          "$ref": "#/$defs/Sources"
        }
      }
    },
    "QuestionDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "blocking",
        "sources"
      ],
      "properties": {
        "question": {
          "$ref": "#/$defs/Text"
        },
        "blocking": {
          "type": "boolean"
        },
        "sources": {
          "$ref": "#/$defs/Sources"
        }
      }
    },
    "SpecOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "obligations",
        "preservation_obligations",
        "open_questions"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/Text"
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetDraft"
          }
        },
        "preservation_obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetDraft"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionDraft"
          }
        }
      }
    }
  }
}
