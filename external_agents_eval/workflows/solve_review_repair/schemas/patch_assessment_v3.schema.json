{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-agents-eval.local/patch_assessment_v3.schema.json",
  "title": "PatchAssessmentV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "patch_sha256", "ledger_sha256", "additional_sources", "late_obligations", "obligation_assessments", "unexpected_regressions", "repair_requests", "verdict", "verdict_rationale"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "additional_sources": {
      "type": "array", "maxItems": 32,
      "items": {"allOf": [{"$ref": "https://external-agents-eval.local/review_obligations_v3.schema.json#/$defs/source"}, {"properties": {"id": {"pattern": "^A[0-9]{2,3}$"}}}]}
    },
    "late_obligations": {
      "type": "array", "maxItems": 32,
      "items": {"allOf": [{"$ref": "https://external-agents-eval.local/review_obligations_v3.schema.json#/$defs/obligation"}, {"properties": {"id": {"pattern": "^L[0-9]{2,3}$"}}}]}
    },
    "obligation_assessments": {"type": "array", "minItems": 1, "maxItems": 96, "items": {"$ref": "#/$defs/assessment"}},
    "unexpected_regressions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/regression"}},
    "repair_requests": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/repairRequest"}},
    "verdict": {"enum": ["approve", "request_changes", "replan", "abstain"]},
    "verdict_rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "$defs": {
    "repoPath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
    "nullableText": {"type": ["string", "null"], "maxLength": 4000},
    "implementationEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "explanation"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "validationEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "result", "explanation"],
      "properties": {
        "command": {"type": "string", "minLength": 1, "maxLength": 3000},
        "result": {"enum": ["passed", "failed", "not_run"]},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation_ref", "source_status", "source_note", "implementation_status", "implementation_evidence", "validation_evidence", "gap"],
      "properties": {
        "obligation_ref": {"type": "string", "pattern": "^(?:O|L)[0-9]{2,3}$"},
        "source_status": {"enum": ["supported", "unsupported", "unclear"]},
        "source_note": {"$ref": "#/$defs/nullableText"},
        "implementation_status": {"enum": ["covered", "partial", "missing", "uncertain", "not_applicable"]},
        "implementation_evidence": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/implementationEvidence"}},
        "validation_evidence": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/validationEvidence"}},
        "gap": {"$ref": "#/$defs/nullableText"}
      }
    },
    "regression": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "source_refs", "blocking", "implementation_evidence", "validation_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^R[0-9]{2,3}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 3000},
        "source_refs": {"$ref": "https://external-agents-eval.local/review_obligations_v3.schema.json#/$defs/sourceRefs"},
        "blocking": {"type": "boolean"},
        "implementation_evidence": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/implementationEvidence"}},
        "validation_evidence": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/validationEvidence"}}
      }
    },
    "repairRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "finding_refs", "action", "problem", "required_outcome", "preserve", "validation"],
      "properties": {
        "id": {"type": "string", "pattern": "^Q[0-9]{2}$"},
        "finding_refs": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:O|L|R)[0-9]{2,3}$"}},
        "action": {"enum": ["fix", "investigate"]},
        "problem": {"type": "string", "minLength": 1, "maxLength": 3000},
        "required_outcome": {"type": "string", "minLength": 1, "maxLength": 3000},
        "preserve": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "validation": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
      }
    }
  }
}
