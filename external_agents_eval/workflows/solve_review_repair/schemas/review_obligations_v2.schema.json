{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-agents-eval.local/review_obligations_v2.schema.json",
  "title": "ReviewObligationsV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "source_policy_sha256", "feature_summary", "scope", "sources", "obligations"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["in_scope", "out_of_scope", "assumptions"],
      "properties": {
        "in_scope": {"$ref": "#/$defs/shortStrings"},
        "out_of_scope": {"$ref": "#/$defs/shortStrings"},
        "assumptions": {"$ref": "#/$defs/shortStrings"}
      }
    },
    "sources": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/source"}},
    "obligations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/obligation"}}
  },
  "$defs": {
    "shortStrings": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "repoPath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "locator"],
          "properties": {
            "id": {"type": "string", "pattern": "^S[0-9]{2,3}$"},
            "kind": {"const": "issue"},
            "locator": {
              "type": "object", "additionalProperties": false, "required": ["field", "quote"],
              "properties": {
                "field": {"enum": ["title", "body"]},
                "quote": {"type": "string", "minLength": 1, "maxLength": 5000}
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "locator"],
          "properties": {
            "id": {"type": "string", "pattern": "^S[0-9]{2,3}$"},
            "kind": {"const": "repository"},
            "locator": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "base_revision", "line_start", "line_end", "quote", "file_sha256"],
              "properties": {
                "path": {"$ref": "#/$defs/repoPath"},
                "base_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1},
                "quote": {"type": "string", "minLength": 1, "maxLength": 5000},
                "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      ]
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "criticality", "basis_kind", "source_refs", "derivation", "open_questions", "confidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^O[0-9]{2}\\.C[0-9]{2}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
        "criticality": {"enum": ["must", "should", "unspecified"]},
        "basis_kind": {"enum": ["explicit_issue", "repository_contract", "compatibility_inferred", "unspecified"]},
        "source_refs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2,3}$"}},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 3000},
        "open_questions": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "obligation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "category", "acceptance_criteria", "affected_surfaces", "dependencies"],
      "properties": {
        "id": {"type": "string", "pattern": "^O[0-9]{2}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 3000},
        "category": {"enum": ["public_api", "configuration", "data_flow", "core_behavior", "error_handling", "backward_compatibility", "integration", "serialization", "concurrency", "performance", "documentation"]},
        "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/criterion"}},
        "affected_surfaces": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "dependencies": {"type": "array", "maxItems": 31, "uniqueItems": true, "items": {"type": "string", "pattern": "^O[0-9]{2}$"}}
      }
    }
  }
}
