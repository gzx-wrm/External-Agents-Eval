{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-agents-eval.local/patch_assessment_v2.schema.json",
  "title": "PatchAssessmentV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "patch_sha256", "ledger_sha256", "additional_sources", "criterion_assessments", "ledger_challenges", "unexpected_regressions", "late_obligation_candidates", "verdict", "verdict_rationale", "abstain_reason", "repair_requests"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "additional_sources": {"type": "array", "maxItems": 32, "items": {"$ref": "https://external-agents-eval.local/review_obligations_v2.schema.json#/$defs/source"}},
    "criterion_assessments": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/criterionAssessment"}},
    "ledger_challenges": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/challenge"}},
    "unexpected_regressions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/regression"}},
    "late_obligation_candidates": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/lateCriterion"}},
    "verdict": {"enum": ["approve", "request_changes", "replan", "abstain"]},
    "verdict_rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "abstain_reason": {"$ref": "#/$defs/nullableText"},
    "repair_requests": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/repairRequest"}}
  },
  "$defs": {
    "nullableText": {"type": ["string", "null"], "maxLength": 4000},
    "repoPath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
    "sourceRefs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2,3}$"}},
    "implementationEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "symbol", "line_start", "line_end", "explanation"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "symbol": {"type": ["string", "null"], "maxLength": 1000},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "testEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "test_name", "command", "result", "explanation"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "test_name": {"type": "string", "minLength": 1, "maxLength": 1000},
        "command": {"type": "string", "minLength": 1, "maxLength": 3000},
        "result": {"enum": ["passed", "failed", "not_run"]},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "sourceCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source_refs", "rationale", "compliant_but_rejected_example", "satisfies_but_violates_example"],
      "properties": {
        "status": {"enum": ["supported", "overstated", "understated", "conflicting", "underdetermined"]},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 3000},
        "compliant_but_rejected_example": {"$ref": "#/$defs/nullableText"},
        "satisfies_but_violates_example": {"$ref": "#/$defs/nullableText"}
      }
    },
    "criterionAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_ref", "source_check", "implementation_status", "implementation_evidence", "test_evidence", "validation_note", "gap", "confidence"],
      "properties": {
        "criterion_ref": {"type": "string", "pattern": "^O[0-9]{2}\\.C[0-9]{2}$"},
        "source_check": {"$ref": "#/$defs/sourceCheck"},
        "implementation_status": {"enum": ["covered", "partial", "missing", "uncertain", "not_applicable"]},
        "implementation_evidence": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/implementationEvidence"}},
        "test_evidence": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/testEvidence"}},
        "validation_note": {"$ref": "#/$defs/nullableText"},
        "gap": {"$ref": "#/$defs/nullableText"},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "challenge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "criterion_ref", "kind", "source_refs", "explanation", "alternative_interpretations", "disposition", "replacement_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^D[0-9]{2}$"},
        "criterion_ref": {"type": "string", "pattern": "^O[0-9]{2}\\.C[0-9]{2}$"},
        "kind": {"enum": ["unsupported_specificity", "weakened_requirement", "source_conflict", "unresolved_meaning"]},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 3000},
        "alternative_interpretations": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "disposition": {"enum": ["nonbinding", "replaced", "unresolved"]},
        "replacement_refs": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^L[0-9]{2}\\.C[0-9]{2}$"}}
      }
    },
    "regression": {
      "type": "object", "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"severity": {"const": "blocker"}}, "required": ["severity"]},
          "then": {"properties": {"blocking": {"const": true}}}
        }
      ],
      "required": ["id", "problem", "severity", "blocking", "source_refs", "implementation_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^R[0-9]{2}$"},
        "problem": {"type": "string", "minLength": 1, "maxLength": 3000},
        "severity": {"enum": ["blocker", "high", "medium", "low"]},
        "blocking": {"type": "boolean"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "implementation_evidence": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/implementationEvidence"}}
      }
    },
    "lateCriterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "criticality", "basis_kind", "source_refs", "derivation", "source_check", "implementation_status", "implementation_evidence", "test_evidence", "gap"],
      "properties": {
        "id": {"type": "string", "pattern": "^L[0-9]{2}\\.C[0-9]{2}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
        "criticality": {"enum": ["must", "should", "unspecified"]},
        "basis_kind": {"enum": ["explicit_issue", "repository_contract", "compatibility_inferred", "unspecified"]},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 3000},
        "source_check": {"$ref": "#/$defs/sourceCheck"},
        "implementation_status": {"enum": ["covered", "partial", "missing", "uncertain"]},
        "implementation_evidence": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/implementationEvidence"}},
        "test_evidence": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/testEvidence"}},
        "gap": {"$ref": "#/$defs/nullableText"}
      }
    },
    "repairRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "priority", "finding_refs", "criterion_refs", "source_refs", "action_kind", "problem", "requested_outcome", "preserve_behaviors", "suggested_validation"],
      "properties": {
        "id": {"type": "string", "pattern": "^Q[0-9]{2}$"},
        "priority": {"type": "integer", "minimum": 1, "maximum": 3},
        "finding_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:O[0-9]{2}\\.C[0-9]{2}|L[0-9]{2}\\.C[0-9]{2}|R[0-9]{2})$"}},
        "criterion_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:O[0-9]{2}\\.C[0-9]{2}|L[0-9]{2}\\.C[0-9]{2})$"}},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "action_kind": {"enum": ["fix", "investigate"]},
        "problem": {"type": "string", "minLength": 1, "maxLength": 3000},
        "requested_outcome": {"type": "string", "minLength": 1, "maxLength": 3000},
        "preserve_behaviors": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "suggested_validation": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
      }
    }
  }
}
