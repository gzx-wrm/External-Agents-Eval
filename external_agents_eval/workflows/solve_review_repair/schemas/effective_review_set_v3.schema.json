{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-agents-eval.local/effective_review_set_v3.schema.json",
  "title": "EffectiveReviewSetV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "ledger_sha256", "assessment_sha256", "effective_obligations", "nonbinding_obligations", "unresolved_obligations", "late_obligation_count", "repair_request_ids", "verdict"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assessment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_obligations": {"type": "array", "maxItems": 96, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:O|L)[0-9]{2,3}$"}},
    "nonbinding_obligations": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^O[0-9]{2,3}$"}},
    "unresolved_obligations": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^O[0-9]{2,3}$"}},
    "late_obligation_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "repair_request_ids": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^Q[0-9]{2}$"}},
    "verdict": {"enum": ["approve", "request_changes", "replan", "abstain"]}
  }
}
