{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-agents-eval.local/build_obligations_input_v3.schema.json",
  "title": "BuildObligationsInputV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task", "repository"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "task": {"$ref": "#/$defs/task"},
    "repository": {"$ref": "#/$defs/repository"}
  },
  "$defs": {
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {"type": "string", "maxLength": 500},
        "description": {"type": "string", "minLength": 1, "maxLength": 100000}
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "base_commit", "worktree", "state"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 300},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "worktree": {"type": "string", "minLength": 1, "maxLength": 4096},
        "state": {"const": "base_only"}
      }
    }
  }
}
