{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-agents-eval.local/review_obligations_v3.schema.json",
  "title": "ReviewObligationsV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "summary", "sources", "obligations", "open_questions"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 96,
      "items": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"id": {"pattern": "^S[0-9]{2,3}$"}}}]}
    },
    "obligations": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"allOf": [{"$ref": "#/$defs/obligation"}, {"properties": {"id": {"pattern": "^O[0-9]{2,3}$"}}}]}
    },
    "open_questions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/openQuestion"}}
  },
  "$defs": {
    "repoPath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
    "sourceRefs": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:S|A)[0-9]{2,3}$"}
    },
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "field", "quote"],
          "properties": {
            "id": {"type": "string", "pattern": "^(?:S|A)[0-9]{2,3}$"},
            "kind": {"const": "task"},
            "field": {"enum": ["title", "description"]},
            "quote": {"type": "string", "minLength": 1, "maxLength": 5000}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "path", "line_start", "line_end"],
          "properties": {
            "id": {"type": "string", "pattern": "^(?:S|A)[0-9]{2,3}$"},
            "kind": {"const": "repository"},
            "path": {"$ref": "#/$defs/repoPath"},
            "line_start": {"type": "integer", "minimum": 1},
            "line_end": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "obligation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "criticality", "basis", "source_refs", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?:O|L)[0-9]{2,3}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
        "criticality": {"enum": ["must", "should"]},
        "basis": {"enum": ["explicit_task", "repository_contract", "compatibility_inferred"]},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "openQuestion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "source_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^U[0-9]{2,3}$"},
        "question": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    }
  }
}
