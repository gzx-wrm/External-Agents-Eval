{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-agents-eval.local/patch_assessment.schema.json",
  "title": "PatchAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "patch_sha256", "ledger_sha256", "obligation_assessments", "unexpected_regressions", "late_obligation_candidates", "verdict", "verdict_rationale", "repair_requests"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "obligation_assessments": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/assessment"}},
    "unexpected_regressions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/regression"}},
    "late_obligation_candidates": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/lateObligation"}},
    "verdict": {"enum": ["approve", "request_changes", "replan"]},
    "verdict_rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "repair_requests": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/repairRequest"}}
  },
  "$defs": {
    "nullableText": {"type": ["string", "null"], "maxLength": 4000},
    "repoPath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
    "implementationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol", "line_start", "line_end", "explanation"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "symbol": {"type": ["string", "null"], "maxLength": 1000},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "test_name", "command", "result", "explanation"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "test_name": {"type": "string", "minLength": 1, "maxLength": 1000},
        "command": {"type": "string", "minLength": 1, "maxLength": 3000},
        "result": {"enum": ["passed", "failed", "not_run"]},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "status", "implementation_evidence", "test_evidence", "validation_note", "gap", "confidence"],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^O[0-9]{2}$"},
        "status": {"enum": ["covered", "partial", "missing", "uncertain"]},
        "implementation_evidence": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/implementationEvidence"}},
        "test_evidence": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/testEvidence"}},
        "validation_note": {"$ref": "#/$defs/nullableText"},
        "gap": {"$ref": "#/$defs/nullableText"},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "origin": {
      "type": "object", "additionalProperties": false, "required": ["type", "evidence", "rationale"],
      "properties": {
        "type": {"enum": ["explicit_issue", "compatibility_inferred", "repository_contract"]},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 3000},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "problem", "severity", "blocking", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^R[0-9]{2}$"},
        "problem": {"type": "string", "minLength": 1, "maxLength": 3000},
        "severity": {"enum": ["blocker", "high", "medium", "low"]},
        "blocking": {"type": "boolean"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/origin"}}
      }
    },
    "lateObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "criticality", "origins", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^L[0-9]{2}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 3000},
        "criticality": {"enum": ["must", "should"]},
        "origins": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/origin"}},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "repairRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "finding_refs", "problem", "requested_outcome", "suggested_validation"],
      "properties": {
        "priority": {"type": "integer", "minimum": 1, "maximum": 3},
        "finding_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[OLR][0-9]{2}$"}},
        "problem": {"type": "string", "minLength": 1, "maxLength": 3000},
        "requested_outcome": {"type": "string", "minLength": 1, "maxLength": 3000},
        "suggested_validation": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
      }
    }
  }
}
