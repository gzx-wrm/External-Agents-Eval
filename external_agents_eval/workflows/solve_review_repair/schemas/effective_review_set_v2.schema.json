{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-agents-eval.local/effective_review_set_v2.schema.json",
  "title": "EffectiveReviewSetV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "ledger_sha256", "assessment_sha256", "effective_criteria", "nonbinding_criteria", "replaced_criteria", "unresolved_criteria", "repair_request_ids", "verdict"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assessment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_criteria": {"type": "array", "maxItems": 288, "items": {"$ref": "#/$defs/effectiveCriterion"}},
    "nonbinding_criteria": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^O[0-9]{2}\\.C[0-9]{2}$"}},
    "replaced_criteria": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/replacement"}},
    "unresolved_criteria": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^O[0-9]{2}\\.C[0-9]{2}$"}},
    "repair_request_ids": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^Q[0-9]{2}$"}},
    "verdict": {"enum": ["approve", "request_changes", "replan", "abstain"]}
  },
  "$defs": {
    "effectiveCriterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_ref", "origin", "criticality", "source_refs", "implementation_status"],
      "properties": {
        "criterion_ref": {"type": "string", "pattern": "^(?:O[0-9]{2}\\.C[0-9]{2}|L[0-9]{2}\\.C[0-9]{2})$"},
        "origin": {"enum": ["ledger", "late"]},
        "criticality": {"enum": ["must", "should"]},
        "source_refs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2,3}$"}},
        "implementation_status": {"enum": ["covered", "partial", "missing", "uncertain"]}
      }
    },
    "replacement": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_ref", "replacement_refs"],
      "properties": {
        "criterion_ref": {"type": "string", "pattern": "^O[0-9]{2}\\.C[0-9]{2}$"},
        "replacement_refs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^L[0-9]{2}\\.C[0-9]{2}$"}}
      }
    }
  }
}
