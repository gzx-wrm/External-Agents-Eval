{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://external-agents-eval.local/repair_input_v3.schema.json",
  "title": "RepairInputV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task", "repository", "candidate_patch", "review_obligations", "patch_assessment", "effective_review_set", "request_contexts", "source_bindings", "audit", "policy"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "task": {"$ref": "https://external-agents-eval.local/build_obligations_input_v3.schema.json#/$defs/task"},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["base_commit", "worktree", "state"],
      "properties": {
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "worktree": {"type": "string", "minLength": 1, "maxLength": 4096},
        "state": {"const": "base_plus_candidate"}
      }
    },
    "candidate_patch": {
      "type": "object", "additionalProperties": false, "required": ["sha256"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "review_obligations": {"$ref": "https://external-agents-eval.local/review_obligations_v3.schema.json"},
    "patch_assessment": {"$ref": "https://external-agents-eval.local/patch_assessment_v3.schema.json"},
    "effective_review_set": {"$ref": "https://external-agents-eval.local/effective_review_set_v3.schema.json"},
    "request_contexts": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/requestContext"}},
    "source_bindings": {"$ref": "https://external-agents-eval.local/source_bindings_v3.schema.json"},
    "audit": {"$ref": "#/$defs/audit"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_repair_rounds", "hidden_evidence_forbidden", "changes_outside_requests_require_audit"],
      "properties": {
        "max_repair_rounds": {"const": 1},
        "hidden_evidence_forbidden": {"const": true},
        "changes_outside_requests_require_audit": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "requestContext": {
      "type": "object", "additionalProperties": false,
      "required": ["order", "request", "obligations", "regressions", "assessments", "source_ids"],
      "properties": {
        "order": {"type": "integer", "minimum": 1, "maximum": 3},
        "request": {"$ref": "https://external-agents-eval.local/patch_assessment_v3.schema.json#/$defs/repairRequest"},
        "obligations": {"type": "array", "maxItems": 24, "items": {"$ref": "https://external-agents-eval.local/review_obligations_v3.schema.json#/$defs/obligation"}},
        "regressions": {"type": "array", "maxItems": 16, "items": {"$ref": "https://external-agents-eval.local/patch_assessment_v3.schema.json#/$defs/regression"}},
        "assessments": {"type": "array", "maxItems": 24, "items": {"$ref": "https://external-agents-eval.local/patch_assessment_v3.schema.json#/$defs/assessment"}},
        "source_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:S|A)[0-9]{2,3}$"}}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "path", "schema_path", "assessment_sha256", "effective_review_set_sha256"],
      "properties": {
        "required": {"type": "boolean"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "schema_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "assessment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "effective_review_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
